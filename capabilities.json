{
  "dataRoles": [],
  "dataViewMappings": [],
  "objects": {
    "locationSettings": {
      "displayName": "Location",
      "properties": {
        "cityName": {
          "displayName": "City Name",
          "description": "Type any city name — e.g. London, Dublin, Manchester, Paris",
          "type": { "text": true }
        }
      }
    },
    "displaySettings": {
      "displayName": "Display",
      "properties": {
        "viewMode": {
          "displayName": "View Mode",
          "description": "Hourly (today) or Daily (7-day forecast)",
          "type": {
            "enumeration": [
              { "displayName": "Hourly", "value": "hourly" },
              { "displayName": "Daily", "value": "daily" }
            ]
          }
        },
        "temperatureUnit": {
          "displayName": "Temperature Unit",
          "type": {
            "enumeration": [
              { "displayName": "Celsius (°C)", "value": "C" },
              { "displayName": "Fahrenheit (°F)", "value": "F" }
            ]
          }
        },
        "hoursToShow": {
          "displayName": "Hourly Slots to Show",
          "description": "Number of hourly time slots displayed (2–12)",
          "type": { "numeric": true }
        },
        "daysToShow": {
          "displayName": "Days to Show",
          "description": "Number of days shown in daily view (2–7)",
          "type": { "numeric": true }
        },
        "showLocation": {
          "displayName": "Show Location Name",
          "type": { "bool": true }
        },
        "showDate": {
          "displayName": "Show Date",
          "type": { "bool": true }
        },
        "showHighLow": {
          "displayName": "Show High / Low",
          "type": { "bool": true }
        },
        "showPrecipitation": {
          "displayName": "Show Precipitation",
          "type": { "bool": true }
        },
        "showHumidity": {
          "displayName": "Show Humidity",
          "type": { "bool": true }
        },
        "showWindSpeed": {
          "displayName": "Show Wind Speed",
          "type": { "bool": true }
        }
      }
    },
    "colorSettings": {
      "displayName": "Colors",
      "properties": {
        "backgroundColor": {
          "displayName": "Background Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "backgroundOpacity": {
          "displayName": "Background Opacity (%)",
          "type": { "numeric": true }
        },
        "textColor": {
          "displayName": "Text Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "accentColor": {
          "displayName": "Accent / Divider Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "highlightColor": {
          "displayName": "Current / Highlight Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "cardStyle": {
          "displayName": "Card Style",
          "type": {
            "enumeration": [
              { "displayName": "Glass (Blur)", "value": "glass" },
              { "displayName": "Solid", "value": "solid" },
              { "displayName": "Gradient", "value": "gradient" },
              { "displayName": "Minimal", "value": "minimal" }
            ]
          }
        },
        "gradientStartColor": {
          "displayName": "Gradient Start Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "gradientEndColor": {
          "displayName": "Gradient End Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "borderRadius": {
          "displayName": "Corner Radius (px)",
          "type": { "numeric": true }
        }
      }
    },
    "iconSettings": {
      "displayName": "Icons",
      "properties": {
        "showIcons": {
          "displayName": "Show Weather Icons",
          "type": { "bool": true }
        },
        "iconSet": {
          "displayName": "Icon Style",
          "type": {
            "enumeration": [
              { "displayName": "Colorful", "value": "colorful" },
              { "displayName": "Monochrome", "value": "monochrome" },
              { "displayName": "Outlined", "value": "outlined" },
              { "displayName": "Filled", "value": "filled" }
            ]
          }
        },
        "iconSize": {
          "displayName": "Icon Size",
          "type": {
            "enumeration": [
              { "displayName": "Small", "value": "small" },
              { "displayName": "Medium", "value": "medium" },
              { "displayName": "Large", "value": "large" }
            ]
          }
        },
        "sunColor": {
          "displayName": "Sun Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "cloudColor": {
          "displayName": "Cloud Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "rainColor": {
          "displayName": "Rain / Snow Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "fontSettings": {
      "displayName": "Font",
      "properties": {
        "fontFamily": {
          "displayName": "Font Family",
          "type": {
            "enumeration": [
              { "displayName": "Segoe UI", "value": "Segoe UI, sans-serif" },
              { "displayName": "Arial", "value": "Arial, sans-serif" },
              { "displayName": "Helvetica", "value": "Helvetica Neue, sans-serif" },
              { "displayName": "Georgia", "value": "Georgia, serif" },
              { "displayName": "Courier", "value": "Courier New, monospace" }
            ]
          }
        },
        "currentTempSize": {
          "displayName": "Current Temp Font Size (px)",
          "type": { "numeric": true }
        },
        "locationFontSize": {
          "displayName": "Location Font Size (px)",
          "type": { "numeric": true }
        },
        "labelFontSize": {
          "displayName": "Label Font Size (px)",
          "type": { "numeric": true }
        }
      }
    }
  },
  "privileges": [
    {
      "name": "WebAccess",
      "essential": true,
      "parameters": [
        "https://api.open-meteo.com",
        "https://geocoding-api.open-meteo.com"
      ]
    }
  ],
  "supportsHighlight": false,
  "suppressDefaultTitle": true
}
